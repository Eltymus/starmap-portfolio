---
import CloseButton from './CloseButton.astro';
---

<dialog id="chart-sheet" class="overlay" aria-labelledby="chart-sheet-title">
  <div class="sheet">
    <div class="sheet-art" aria-hidden="true"></div>
    <CloseButton class="sheet-close" label="Close the chart" />
    <div class="sheet-body"></div>
    <div class="sheet-footer">
      <button class="sheet-prev" type="button"></button>
      <span class="sheet-counter" aria-hidden="true"></span>
      <button class="sheet-next" type="button"></button>
    </div>
    <p class="sheet-announcer visually-hidden" aria-live="polite"></p>
  </div>
</dialog>
