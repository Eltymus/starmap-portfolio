---
import Frame from './Frame.astro';
import IntroSplash from './IntroSplash.astro';
import MoonNav from './MoonNav.astro';
import SiteHeader from './SiteHeader.astro';
---

<div id="stage">
  <canvas id="sky-canvas" aria-hidden="true"></canvas>
  <Frame />
  <SiteHeader />
  <div id="coords" aria-hidden="true">
    RA 00h 00m · DEC +00°
  </div>
  <MoonNav />
  <div id="scroll-hint" aria-hidden="true">
    SCROLL TO CHART
  </div>
  <IntroSplash />
</div>
