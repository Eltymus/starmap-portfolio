---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import ButtonRow from '../components/ButtonRow.astro';
import Cameo from '../components/Cameo.astro';
import Chapter from '../components/Chapter.astro';
import ChartSheetDialog from '../components/ChartSheetDialog.astro';
import ChartSheetPage from '../components/ChartSheetPage.astro';
import Chips from '../components/Chips.astro';
import FullMapDialog from '../components/FullMapDialog.astro';
import Kicker from '../components/Kicker.astro';
import Link from '../components/Link.astro';
import StackList from '../components/StackList.astro';
import StarMapStage from '../components/StarMapStage.astro';
import StarTip from '../components/StarTip.astro';
import Timeline from '../components/Timeline.astro';
import { CHAPTERS } from '../data/chapters';

const EMAIL = 'lorenzo.tripodi98@gmail.com';
---

<Base>
  <div id="scroller">
    <StarMapStage />
    <StarTip />
    <FullMapDialog />
    <ChartSheetDialog />

    <div id="sections">
      <Chapter index={0} variant="free">
        <Cameo />
        <Kicker>A star map of</Kicker>
        <h1>Lorenzo Tripodi</h1>
        <span class="lead">
          Software developer from Turin. Every project I’ve built is a constellation — scroll and I’ll draw them for
          you.
        </span>
        <ButtonRow>
          <Button go={1}>BEGIN THE CHART</Button>
        </ButtonRow>
      </Chapter>

      <Chapter index={1} title="About me">
        <p>
          I ship complete products — from UI and APIs to databases, deployment and the automations that keep them
          running. I treat AI as a force multiplier while keeping code clean, secure and reviewed.
        </p>
        <Chips items={['Turin, Italy', 'Italian · English · Spanish', 'Remote / Hybrid']} />
      </Chapter>

      <Chapter index={2} title="The stack">
        <StackList
          groups={[
            ['AI & AUTOMATION', 'n8n, LLM agents, prompt engineering, Claude'],
            ['FRONT END', 'Vue 3, Nuxt 4, React, Next.js, Remix, Tailwind'],
            ['BACK END', 'Node.js, Express, Nitro, Supabase, PostgreSQL, MongoDB'],
            ['DEVOPS', 'Docker, GitHub Actions, Vercel, Hetzner, Cloudflare']
          ]}
        />
      </Chapter>

      <Chapter index={3} title="Siply" note="2026 —">
        <p>
          An early-stage startup where I own the product end-to-end: headless storefronts on Shopify Hydrogen &amp;
          Remix, custom Odoo ERP connectors, UI/UX and marketing assets — plus AI agents that took over catalog and
          content work.
        </p>
        <Link href="https://siply.it">siply.it →</Link>
      </Chapter>

      <Chapter index={4} title="Book Relay">
        <p>
          A book-exchange &amp; social platform where I’m CTO and lead developer: architecture, backend, front end and
          deployment. Node.js/Express on Supabase, with Google Books, Open Library and ISBNdb behind a caching layer.
        </p>
        <Link href="https://bookrelay.it">bookrelay.it →</Link>
      </Chapter>

      <Chapter index={5} title="TavernVTT">
        <p>
          A self-hosted D&amp;D 5e virtual tabletop: Nuxt 4 and SQLite on a rules-as-data engine, separate DM and player
          UIs, Docker behind Cloudflare Tunnel with Litestream backups.
        </p>
      </Chapter>

      <Chapter index={6} title="The climb">
        <Timeline
          rows={[
            ['Siply — Developer & Product Designer', '2026 —'],
            ['ISLM — ODV Portal', 'Jul–Sep 2025'],
            ['Promemoria Group — Developer', 'Jan–Jul 2025'],
            ['Independent web projects', '2023 —']
          ]}
        />
      </Chapter>

      <Chapter index={7} variant="free">
        <Kicker index={7} note="Available January 2027" />
        <h2 class="display">Send word, and let’s chart the next one.</h2>
        <ButtonRow>
          <Button href={'mailto:' + EMAIL}>EMAIL ME</Button>
          <Button href="https://linkedin.com/in/lorenzo-tripodi-1173aa1b3" variant="ghost">
            LINKEDIN
          </Button>
          <Button href="https://github.com/Eltymus" variant="ghost">
            GITHUB
          </Button>
        </ButtonRow>
        <span class="fine-print">{EMAIL}</span>
        <Button go={0} variant="text">
          ↑ Back to the first star
        </Button>
      </Chapter>
    </div>
  </div>

  {CHAPTERS.map((_, i) => (
    <ChartSheetPage index={i} />
  ))}

  <script>
    import { startStarMap } from '../scripts/starmap';
    startStarMap();
  </script>
</Base>
